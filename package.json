{
  "name": "dsj2-web",
  "private": true,
  "description": "Browser ski jumping game whose jump physics is a port of Deluxe Ski Jump 2 (v2.10P, DOS).",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visvaya/dsj2-web.git"
  },
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "pnpm build && node scripts/build-single-file.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "check:dist": "node scripts/check-dist.mjs",
    "mutation": "stryker run"
  },
  "dependencies": {
    "@fontsource/silkscreen": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "4.1.11",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  }
}
