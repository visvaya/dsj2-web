{
  "name": "telemark",
  "private": true,
  "description": "Browser ski jumping game whose jump physics is a port of Deluxe Ski Jump 2 (v2.10P, DOS).",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visvaya/telemark.git"
  },
  "version": "0.15.14",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/write-release.mjs",
    "build:single": "tsc --noEmit && vite build && node scripts/write-release.mjs && node scripts/build-single-file.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:unused": "cross-env KNIP_DISABLE_RAW_TRANSFER=1 knip",
    "check:duplicates": "jscpd .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:hills-stability": "cross-env HILL_STABILITY=1 vitest run src/hills/hill-play.stability.test.ts",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "test:browser": "playwright test",
    "test:browser:edge": "cross-env BROWSER_TESTS_EDGE=1 playwright test",
    "test:browser:perf": "cross-env BROWSER_TESTS_PERF=1 playwright test",
    "test:browser:perf:edge": "cross-env BROWSER_TESTS_PERF=1 BROWSER_TESTS_EDGE=1 playwright test",
    "check:dist": "node scripts/check-dist.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "mutation": "stryker run"
  },
  "dependencies": {
    "@fontsource/silkscreen": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "4.1.11",
    "cross-env": "10.1.0",
    "jscpd": "5.4.1",
    "knip": "6.41.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  }
}
